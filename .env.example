# --- AI providers (server-side only; set these in Vercel → Project → Settings → Environment Variables) ---
# Claude: room understanding, product selection, hotspot mapping. Create at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI: photo-realistic editing of the user's room photo. Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=high

# Optional: require a passcode to use the app (protects your API credits on a public URL)
APP_ACCESS_CODE=

# Force demo mode (stand-in AI, no API calls). Also used automatically when keys are missing.
AI_MOCK=
